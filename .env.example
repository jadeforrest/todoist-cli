# Copy to ~/.config/todoist-cli/.env (or export these in your shell).
# Never commit a real .env.

# Todoist API token: https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=your_todoist_api_token_here

# Google account for `todoist start` / `log` / `plan` (via gog). Optional if
# plan.toml sets `account`.
GOG_ACCOUNT=you@example.com
